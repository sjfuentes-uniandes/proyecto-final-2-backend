{
  "name": "pagos consulta de desembolso, rechazado (ben-sint-008 y ben-sint-rechaza)",
  "request": {
    "method": "GET",
    "urlPath": "/pagos/v1/desembolsos",
    "queryParameters": {
      "beneficiario": {
        "matches": "^(ben-sint-008|ben-sint-rechaza)$"
      },
      "referencia": {
        "matches": "IND-88-[0-9]{4}-[0-9]{4,}-[0-9]{2}"
      }
    },
    "headers": {
      "X-Api-Key": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "referencia": "{{request.query.referencia}}",
      "estado": "RECHAZADO",
      "transaccionId": null,
      "motivo": "BENEFICIARIO_NO_HABILITADO"
    },
    "transformers": [
      "response-template"
    ],
    "fixedDelayMilliseconds": 50
  }
}
