{
  "name": "firma por cliente, C07 caído (la firma no llega)",
  "request": {
    "method": "POST",
    "urlPath": "/firma/v1/firmas",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.firmante",
          "equalTo": "00000000-0000-4000-8000-000000000007"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.documentoId",
          "matches": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.huella",
          "matches": "^sha256:[0-9a-f]{64}$"
        }
      }
    ],
    "headers": {
      "X-Api-Key": {
        "matches": ".+"
      },
      "Idempotency-Key": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 503,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": "unavailable"
    },
    "fixedDelayMilliseconds": 50
  }
}
