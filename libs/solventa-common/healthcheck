#!/usr/bin/env python3
# Contrato de las imágenes (infra/apps, health_check_command): sale con 0 si GET /health responde 200.
import os
import sys
from urllib.request import urlopen

try:
    with urlopen(f"http://127.0.0.1:{os.getenv('PORT', '8080')}/health", timeout=1.5) as response:
        sys.exit(0 if response.status == 200 else 1)
except Exception:
    sys.exit(1)
