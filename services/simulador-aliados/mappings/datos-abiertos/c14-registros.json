{
  "name": "datos-abiertos C14 registros nominal",
  "request": {
    "method": "GET",
    "urlPath": "/datos-abiertos/v1/registros/00000000-0000-4000-8000-00000000000e",
    "queryParameters": {
      "campos": {
        "equalTo": "listasRestrictivas"
      }
    },
    "headers": {
      "X-Api-Key": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "datos-abiertos/c14-registros.json",
    "fixedDelayMilliseconds": 50
  }
}
