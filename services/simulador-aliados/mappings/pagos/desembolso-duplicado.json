{
  "name": "pagos desembolso por beneficiario, duplicado (la misma referencia devuelve el mismo transaccionId)",
  "request": {
    "method": "POST",
    "urlPath": "/pagos/v1/desembolsos",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.beneficiario",
          "matches": "^ben-sint-duplicado$"
        }
      },
      {
        "matchesJsonPath": {
          "expression": "$.referencia",
          "matches": "IND-88-[0-9]{4}-[0-9]{4,}-[0-9]{2}"
        }
      },
      {
        "matchesJsonPath": "$.monto"
      },
      {
        "matchesJsonPath": "$.moneda"
      }
    ],
    "headers": {
      "X-Api-Key": {
        "matches": ".+"
      },
      "Idempotency-Key": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "referencia": "{{jsonPath request.body '$.referencia'}}",
      "estado": "CONFIRMADO",
      "transaccionId": "TRX-SINT-DUPLICADO",
      "motivo": null
    },
    "transformers": [
      "response-template"
    ],
    "fixedDelayMilliseconds": 50
  }
}
