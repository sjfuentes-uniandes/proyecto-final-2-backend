{
  "$defs": {
    "CondicionesOferta": {
      "additionalProperties": false,
      "description": "Condiciones de la oferta que se crea con la prima (HU-W04).\n\n`vigenciaMinutos` cuenta desde el c\u00e1lculo: vigente si ahora < calculadoEn + vigenciaMinutos.",
      "properties": {
        "exclusiones": {
          "items": {
            "$ref": "#/$defs/Exclusion"
          },
          "maxItems": 20,
          "title": "Exclusiones",
          "type": "array"
        },
        "sumasCoberturas": {
          "items": {
            "$ref": "#/$defs/SumaCobertura"
          },
          "title": "Sumascoberturas",
          "type": "array"
        },
        "vigenciaMinutos": {
          "maximum": 525600,
          "minimum": 1,
          "title": "Vigenciaminutos",
          "type": "integer"
        }
      },
      "required": [
        "vigenciaMinutos",
        "exclusiones",
        "sumasCoberturas"
      ],
      "title": "CondicionesOferta",
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
      "description": "Exclusi\u00f3n resumida que el socio muestra al cliente; el texto legal est\u00e1 en el condicionado.",
      "properties": {
        "codigo": {
          "pattern": "^[A-Z0-9_]{1,64}$",
          "title": "Codigo",
          "type": "string"
        },
        "descripcion": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Descripcion",
          "type": "string"
        }
      },
      "required": [
        "codigo",
        "descripcion"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "FactorVariable": {
      "additionalProperties": false,
      "properties": {
        "codigo": {
          "title": "Codigo",
          "type": "string"
        },
        "tramos": {
          "items": {
            "$ref": "#/$defs/Tramo"
          },
          "title": "Tramos",
          "type": "array"
        },
        "variable": {
          "title": "Variable",
          "type": "string"
        }
      },
      "required": [
        "codigo",
        "variable",
        "tramos"
      ],
      "title": "FactorVariable",
      "type": "object"
    },
    "FactoresNivel": {
      "additionalProperties": false,
      "description": "Factor por nivel de riesgo del perfil; SIN_PERFIL se aplica cuando no hay nivel.",
      "properties": {
        "ALTO": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Alto",
          "type": "string"
        },
        "BAJO": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Bajo",
          "type": "string"
        },
        "MEDIO": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Medio",
          "type": "string"
        },
        "SIN_PERFIL": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Sin Perfil",
          "type": "string"
        }
      },
      "required": [
        "BAJO",
        "MEDIO",
        "ALTO",
        "SIN_PERFIL"
      ],
      "title": "FactoresNivel",
      "type": "object"
    },
    "Limites": {
      "additionalProperties": false,
      "properties": {
        "edad": {
          "$ref": "#/$defs/Rango"
        },
        "plazoCreditoMeses": {
          "$ref": "#/$defs/Rango"
        },
        "sumaAsegurada": {
          "$ref": "#/$defs/Rango"
        }
      },
      "required": [
        "sumaAsegurada",
        "plazoCreditoMeses",
        "edad"
      ],
      "title": "Limites",
      "type": "object"
    },
    "Rango": {
      "additionalProperties": false,
      "properties": {
        "maximo": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Maximo",
          "type": "string"
        },
        "minimo": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Minimo",
          "type": "string"
        }
      },
      "required": [
        "minimo",
        "maximo"
      ],
      "title": "Rango",
      "type": "object"
    },
    "Recargo": {
      "additionalProperties": false,
      "description": "Recargo de una cobertura opcional: `tasa` \u00d7 prima ajustada.",
      "properties": {
        "cobertura": {
          "title": "Cobertura",
          "type": "string"
        },
        "tasa": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Tasa",
          "type": "string"
        }
      },
      "required": [
        "cobertura",
        "tasa"
      ],
      "title": "Recargo",
      "type": "object"
    },
    "Redondeo": {
      "additionalProperties": false,
      "properties": {
        "escala": {
          "maximum": 6,
          "minimum": -6,
          "title": "Escala",
          "type": "integer"
        },
        "modo": {
          "enum": [
            "ROUND_HALF_EVEN",
            "ROUND_HALF_UP",
            "ROUND_HALF_DOWN",
            "ROUND_UP",
            "ROUND_DOWN"
          ],
          "title": "Modo",
          "type": "string"
        }
      },
      "required": [
        "escala",
        "modo"
      ],
      "title": "Redondeo",
      "type": "object"
    },
    "SumaCobertura": {
      "additionalProperties": false,
      "description": "Parte de la suma asegurada que cubre una cobertura (0 < porcentaje \u2264 1); sin entrada, 1.",
      "properties": {
        "cobertura": {
          "title": "Cobertura",
          "type": "string"
        },
        "porcentaje": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Porcentaje",
          "type": "string"
        }
      },
      "required": [
        "cobertura",
        "porcentaje"
      ],
      "title": "SumaCobertura",
      "type": "object"
    },
    "Tramo": {
      "additionalProperties": false,
      "description": "Factor para los valores \u2264 `hasta`; el \u00faltimo tramo es abierto (`hasta` nulo).",
      "properties": {
        "factor": {
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "title": "Factor",
          "type": "string"
        },
        "hasta": {
          "anyOf": [
            {
              "pattern": "^-?\\d+(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hasta"
        }
      },
      "required": [
        "hasta",
        "factor"
      ],
      "title": "Tramo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "factoresNivel": {
      "$ref": "#/$defs/FactoresNivel"
    },
    "factoresVariables": {
      "items": {
        "$ref": "#/$defs/FactorVariable"
      },
      "title": "Factoresvariables",
      "type": "array"
    },
    "limites": {
      "$ref": "#/$defs/Limites"
    },
    "moneda": {
      "pattern": "^[A-Z]{3}$",
      "title": "Moneda",
      "type": "string"
    },
    "oferta": {
      "anyOf": [
        {
          "$ref": "#/$defs/CondicionesOferta"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "periodicidad": {
      "enum": [
        "MENSUAL",
        "ANUAL"
      ],
      "title": "Periodicidad",
      "type": "string"
    },
    "primaMaxima": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Primamaxima",
      "type": "string"
    },
    "primaMinima": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Primaminima",
      "type": "string"
    },
    "productoId": {
      "title": "Productoid",
      "type": "string"
    },
    "recargos": {
      "items": {
        "$ref": "#/$defs/Recargo"
      },
      "title": "Recargos",
      "type": "array"
    },
    "redondeo": {
      "$ref": "#/$defs/Redondeo"
    },
    "tasaBase": {
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "title": "Tasabase",
      "type": "string"
    }
  },
  "required": [
    "productoId",
    "moneda",
    "periodicidad",
    "tasaBase",
    "factoresNivel",
    "factoresVariables",
    "recargos",
    "primaMinima",
    "primaMaxima",
    "redondeo",
    "limites"
  ],
  "title": "DefinicionReglasPrima",
  "type": "object"
}
