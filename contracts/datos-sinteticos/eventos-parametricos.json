{
  "descripcion": "Eventos paramétricos sintéticos de R5 (HU-W21 y HU-W22, plan §1.8): las coberturas (PolizaEmitida.v1 con coberturaParametrica), el orden de los eventos de póliza, los eventos externos que firma y envía la fuente de telemetría (válidos y rechazados) y los mensajes que llegan directo a la cola. Datos 100 % sintéticos, sin secretos: el HMAC se calcula al enviar. `desfaseSegundos` es relativo al envío; los instantes de `observadoEn` y las vigencias son absolutos.",
  "version": "1",
  "versionRegla": "1",
  "fuentes": [
    "IDEAM-SIM",
    "AEROCIVIL-SIM"
  ],
  "eventoId": "uuid5(NAMESPACE_URL, 'telemetria/<fuente>/<idExterno>')",
  "firma": {
    "algoritmo": "HMAC-SHA256",
    "cadenaFirmada": "<X-Telemetria-Marca-Tiempo>.<cuerpo crudo>",
    "encabezado": "X-Telemetria-Firma: sha256=<hex>",
    "valores": {
      "VALIDA": "firma correcta con la fuente y la marca del envío",
      "ALTERADA": "firma correcta con el último dígito hexadecimal cambiado",
      "AUSENTE": "sin el encabezado X-Telemetria-Firma"
    }
  },
