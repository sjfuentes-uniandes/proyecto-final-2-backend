{
  "name": "open-finance C13 payment-history lento",
  "request": {
    "method": "GET",
    "urlPath": "/open-finance/v3/customers/00000000-0000-4000-8000-00000000000d/payment-history",
    "queryParameters": {
      "months": {
        "equalTo": "12"
      },
      "fields": {
        "equalTo": "lateCount"
      }
    },
    "headers": {
      "X-Api-Key": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "open-finance/c13-payment-history.json",
    "fixedDelayMilliseconds": 1000
  }
}
