{
  "name": "open-finance C29 aggregated-income nominal",
  "request": {
    "method": "GET",
    "urlPath": "/open-finance/v3/customers/00000000-0000-4000-8000-00000000001d/aggregated-income",
    "queryParameters": {
      "fields": {
        "equalTo": "estimatedMonthlyIncome"
      }
    },
    "headers": {
      "X-Api-Key": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "bodyFileName": "open-finance/c29-aggregated-income.json",
    "fixedDelayMilliseconds": 50
  }
}
