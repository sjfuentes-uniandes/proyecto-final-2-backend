{
  "name": "push proveedor lento (supera el timeout de 2 s)",
  "request": {
    "method": "POST",
    "urlPath": "/push/v1/envios",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.tokenDispositivo",
          "equalTo": "token-sintetico-lento"
        }
      }
    ],
    "headers": {
      "X-Api-Key": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "estado": "ENVIADO",
      "envioId": "PUSH-SINT-0001"
    },
    "fixedDelayMilliseconds": 4000
  }
}
