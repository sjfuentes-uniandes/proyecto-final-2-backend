    "AccionFallback": {
      "description": "DEGRADAR: oferta provisional sin el dato. PENDIENTE: sin oferta, estado recuperable.",
      "enum": [
        "DEGRADAR",
        "PENDIENTE"
      ],
      "title": "AccionFallback",
      "type": "string"
    },
    "AccionSugerida": {
      "description": "Con PENDIENTE: reintentar con el mismo perfil no cambia nada; hay que recalcularlo (HU-W12).",
      "enum": [
        "RECALCULAR_PERFIL"
      ],
      "title": "AccionSugerida",
      "type": "string"
    },
