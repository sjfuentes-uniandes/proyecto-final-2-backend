{
  "$defs": {
    "EventoParametricoObservadoV1": {
      "additionalProperties": false,
      "description": "Un evento externo aut\u00e9ntico y con contrato v\u00e1lido; todav\u00eda sin evaluar.",
      "properties": {
        "archivoRef": {
          "description": "Clave del original archivado en el bucket de evidencias",
          "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*/[0-9]{4}/[0-9]{2}/[0-9]{2}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.json$",
          "title": "Archivoref",
          "type": "string"
        },
        "eventoId": {
          "description": "UUIDv5 de (fuente, idExterno); es tambi\u00e9n el eventId",
          "format": "uuid",
          "title": "Eventoid",
          "type": "string"
        },
        "eventoOrigen": {
          "examples": [
            "EVT-2026-0913"
          ],
          "pattern": "^[A-Za-z0-9._:-]{1,64}$",
          "title": "Eventoorigen",
          "type": "string"
        },
        "fuente": {
          "examples": [
            "IDEAM-SIM"
          ],
          "pattern": "^[A-Z][A-Z0-9-]{1,31}$",
          "title": "Fuente",
          "type": "string"
        },
        "idExterno": {
          "examples": [
            "IDEAM-2026-1110-0001"
          ],
          "pattern": "^[A-Za-z0-9._:-]{1,64}$",
          "title": "Idexterno",
          "type": "string"
        },
        "observadoEn": {
          "format": "date-time",
          "title": "Observadoen",
          "type": "string"
        },
        "recibidoEn": {
          "format": "date-time",
          "title": "Recibidoen",
          "type": "string"
        },
        "tipoEvento": {
          "$ref": "#/$defs/TipoEvento"
        },
        "unidad": {
          "$ref": "#/$defs/Unidad"
        },
        "valorObservado": {
          "examples": [
            "135.5"
          ],
          "pattern": "^[0-9]{1,9}(\\.[0-9]{1,3})?$",
          "title": "Valorobservado",
          "type": "string"
        },
        "zona": {
          "examples": [
            "11001"
          ],
          "pattern": "^[A-Z0-9]{2,16}$",
          "title": "Zona",
          "type": "string"
        }
      },
      "required": [
        "eventoId",
        "fuente",
        "idExterno",
        "eventoOrigen",
        "tipoEvento",
        "valorObservado",
        "unidad",
        "zona",
        "observadoEn",
        "recibidoEn",
        "archivoRef"
      ],
      "title": "EventoParametricoObservadoV1",
      "type": "object"
    },
    "TipoEvento": {
      "enum": [
        "LLUVIA_ACUMULADA",
        "RETRASO_VUELO"
      ],
      "title": "TipoEvento",
      "type": "string"
    },
    "Unidad": {
      "enum": [
        "mm",
        "min"
      ],
      "title": "Unidad",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Sobre versionado con `type` fijo: es el atributo `eventType` del mensaje (HU-S03).",
  "properties": {
    "aggregateId": {
      "format": "uuid",
      "title": "Aggregateid",
      "type": "string"
    },
    "correlationId": {
      "title": "Correlationid",
      "type": "string"
    },
    "eventId": {
      "format": "uuid",
      "title": "Eventid",
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "title": "Occurredat",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/EventoParametricoObservadoV1"
    },
    "type": {
      "const": "EventoParametricoObservado",
      "title": "Type",
      "type": "string"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "eventId",
    "aggregateId",
    "type",
    "version",
    "occurredAt",
    "correlationId",
    "payload"
  ],
  "title": "SobreEventoParametricoObservadoV1",
  "type": "object"
