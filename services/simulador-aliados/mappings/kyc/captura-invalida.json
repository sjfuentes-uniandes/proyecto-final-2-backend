{
  "name": "kyc captura inválida (AC2: reintentable)",
  "request": {
    "method": "POST",
    "urlPath": "/kyc/v1/verificaciones",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.selfie",
          "equalTo": "selfie-sintetica-captura-invalida"
        }
      }
    ],
    "headers": {
      "X-Api-Key": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "resultado": "CAPTURA_INVALIDA",
      "motivo": "ILUMINACION_INSUFICIENTE"
    },
    "fixedDelayMilliseconds": 50
  }
}
