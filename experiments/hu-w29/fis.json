{
  "description": "HU-W29 ARQ-001: perdida controlada de la zona A durante 10 minutos y failover de RDS al standby de la zona B",
  "roleArn": "${FIS_ROLE_ARN}",
  "stopConditions": [
    {
      "source": "aws:cloudwatch:alarm",
      "value": "${ALARMA_PARADA_ARN}"
    }
  ],
  "targets": {
    "SubredesZonaA": {
      "resourceType": "aws:ec2:subnet",
      "resourceArns": ["${SUBRED_PRIVADA_A_ARN}", "${SUBRED_DATOS_A_ARN}"],
      "selectionMode": "ALL"
    },
    "BasePrincipal": {
      "resourceType": "aws:rds:db",
      "resourceArns": ["${DB_ARN}"],
      "selectionMode": "ALL"
    }
  },
  "actions": {
    "InterrumpirZonaA": {
      "description": "Toda la red de las subredes privadas y de datos de la zona A (ACL de FIS); se restaura al terminar",
      "actionId": "aws:network:disrupt-connectivity",
      "parameters": {
        "duration": "PT10M",
        "scope": "all"
      },
      "targets": {
        "Subnets": "SubredesZonaA"
      }
    },
    "FailoverBase": {
      "description": "Reinicio con failover forzado: el standby de la zona B pasa a ser la base principal",
      "actionId": "aws:rds:reboot-db-instances",
      "parameters": {
        "forceFailover": "true"
      },
      "targets": {
        "DBInstances": "BasePrincipal"
      }
    }
  },
  "experimentOptions": {
    "accountTargeting": "single-account",
    "emptyTargetResolutionMode": "fail"
  },
  "tags": {
    "Name": "${PREFIJO}-hu-w29-multizona",
    "Historia": "HU-W29",
    "Environment": "${AMBIENTE}"
  }
}
